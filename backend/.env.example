# Puerto del servidor
PORT=5000

# MongoDB (Atlas)
MONGO_URI=tu_connection_string_de_mongodb_atlas

# Cloudinary
CLOUDINARY_CLOUD_NAME=tu_cloud_name
CLOUDINARY_API_KEY=tu_api_key
CLOUDINARY_API_SECRET=tu_api_secret

# Anthropic (Claude API)
ANTHROPIC_API_KEY=tu_api_key_de_claude
CLAUDE_MODEL=claude-haiku-4-5-20251001

# Frontend (para CORS)
FRONTEND_URL=http://localhost:8888

# Seguridad
JWT_SECRET=cambia_esto_por_una_clave_larga_y_aleatoria

# Mercado Pago (dejalo vacío hasta que tengas la cuenta creada)
MP_ACCESS_TOKEN=

# Clave secreta del webhook (Panel de Mercado Pago → Tus integraciones → tu app → Webhooks → "Configurar notificaciones").
# Sin esto, el servidor todavía acepta el webhook pero queda sin protección: cualquiera podría simular un pago aprobado.
MP_WEBHOOK_SECRET=

# Notificaciones push (avisos aunque el cliente tenga el chat cerrado).
# Se generan UNA sola vez, ejecutando en la carpeta backend: npx web-push generate-vapid-keys
VAPID_PUBLIC_KEY=
VAPID_PRIVATE_KEY=
VAPID_SUBJECT=mailto:tu-email@tudominio.com

# Precios de los planes en pesos argentinos (se pueden cambiar sin tocar código)
PRECIO_1_MES=20000
PRECIO_3_MESES=54000
PRECIO_6_MESES=96000

# URL pública del backend (Render), la usa Mercado Pago para avisar cuando se aprueba un pago
BACKEND_URL=https://empleado-virtual-ia.onrender.com

# Códigos de administración que NUNCA vencen (para que vos puedas probar sin pagar). Separados por coma.
CODIGOS_OWNER=

# Google Sign-In (Google Cloud Console → APIs y servicios → Credenciales → ID de cliente OAuth 2.0)
GOOGLE_CLIENT_ID=553562775987-ovo25d12tq3fhntvj34342nk3jlg7vtc.apps.googleusercontent.com
